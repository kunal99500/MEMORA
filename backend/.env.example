APP_ENV=development
MEMORA_SECRET=CHANGE-ME-TO-A-RANDOM-SECRET-AT-LEAST-32-CHARS
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true
DATABASE_URL=sqlite:///./data/memora.db
MEDIA_ROOT=./data/media
MAX_UPLOAD_MB=50
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
META_API_KEY=
META_API_BASE=https://api.meta.ai/v1
MUSE_SPARK_MODEL=muse-spark-1.3
YOLO_ENABLED=false
YOLO_MODEL_PATH=
OCR_ENABLED=false
BARCODE_ENABLED=true

# Local Android phone camera test. Map a non-secret reference to your RTSP URL.
# Example: {"phonecam":"rtsp://192.168.1.20:8554/live"}
MEMORA_CAMERA_STREAMS_JSON={}
CAMERA_INGESTION_ENABLED=true
CAMERA_SAMPLE_INTERVAL_SECONDS=30
